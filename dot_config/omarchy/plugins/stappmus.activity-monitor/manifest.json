{
  "schemaVersion": 1,
  "id": "stappmus.activity-monitor",
  "name": "Activity Monitor",
  "version": "2.1.1",
  "author": "Kristoffer Haugland",
  "license": "MIT",
  "description": "Native low-overhead CPU, RAM, GPU, storage, process, and estimated CPU-package power monitoring",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Activity Monitor",
    "description": "A quick system overview with expandable GPU memory, resources, storage, processes, and estimated per-process CPU-package power share.",
    "category": "System",
    "aliases": [
      "activity",
      "system-monitor",
      "btop"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "samplingSpeed": "Balanced",
      "historySamples": 60,
      "temperatureUnit": "Celsius",
      "showFrequencies": true,
      "openExpanded": false,
      "processPowerEnabled": true
    },
    "schema": [
      {
        "key": "samplingSpeed",
        "type": "enum",
        "label": "Update speed",
        "options": ["Efficient", "Balanced", "Fast"],
        "defaultValue": "Balanced",
        "description": "Efficient uses fewer samples; Fast makes the graphs react sooner."
      },
      {
        "key": "historySamples",
        "type": "integer",
        "label": "History samples",
        "min": 20,
        "max": 240,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "temperatureUnit",
        "type": "enum",
        "label": "Temperature unit",
        "options": ["Celsius", "Fahrenheit"],
        "defaultValue": "Celsius"
      },
      {
        "key": "showFrequencies",
        "type": "boolean",
        "label": "Show hardware speeds",
        "defaultValue": true
      },
      {
        "key": "openExpanded",
        "type": "boolean",
        "label": "Open detailed view",
        "defaultValue": false
      },
      {
        "key": "processPowerEnabled",
        "type": "boolean",
        "label": "Process power estimates",
        "defaultValue": true,
        "description": "Disable to skip CPU package-energy sampling in the detailed view."
      }
    ]
  }
}
