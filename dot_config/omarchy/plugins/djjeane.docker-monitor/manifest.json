{
  "schemaVersion": 1,
  "id": "djjeane.docker-monitor",
  "name": "Docker Monitor",
  "version": "1.0.0",
  "author": "djjeane",
  "description": "Monitor Docker containers with live status, CPU, and memory usage.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Docker Monitor",
    "description": "Docker container monitoring with status, CPU, and memory stats.",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "pollIntervalSec": 10,
      "showStoppedContainers": true,
      "notificationsEnabled": true,
      "logLines": 100
    },
    "schema": [
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "showStoppedContainers",
        "type": "boolean",
        "label": "Show stopped containers",
        "defaultValue": true
      },
      {
        "key": "notificationsEnabled",
        "type": "boolean",
        "label": "Desktop notifications",
        "defaultValue": true
      },
      {
        "key": "logLines",
        "type": "integer",
        "label": "Log lines to show",
        "min": 25,
        "max": 500,
        "step": 25,
        "defaultValue": 100
      }
    ]
  }
}
